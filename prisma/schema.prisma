generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SquishLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}
